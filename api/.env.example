PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/talentflow
RUN_MIGRATIONS=true
LOG_LEVEL=info

# Optional AI scoring. Any OpenAI-compatible endpoint works:
#   OpenAI:          LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
#   Ollama (local):  LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1
#   vLLM (local):    LLM_BASE_URL=http://localhost:8000/v1    LLM_MODEL=<served model name>
# Leave LLM_BASE_URL empty to use the built-in keyword scorer only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000
LLM_MAX_ATTEMPTS=2
